# Domain and routing
APP_DOMAIN=nailmarket.ru
API_DOMAIN=api.nailmarket.ru
ADMIN_DOMAIN=admin.nailmarket.ru

# App runtime
NODE_ENV=production
TZ=Europe/Moscow

# Database
POSTGRES_DB=nailmarket
POSTGRES_USER=nailmarket
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql://nailmarket:change_me_postgres_password@postgres:5432/nailmarket

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
DEV_OTP_ENABLED=false

# S3-compatible storage (external recommended for production)
S3_ENDPOINT=https://s3.example.ru
S3_REGION=ru-1
S3_BUCKET=nailmarket
S3_ACCESS_KEY=change_me_s3_access_key
S3_SECRET_KEY=change_me_s3_secret_key

# Email
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_USER=change_me_smtp_user
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=no-reply@nailmarket.ru

# Internal service ports
WEB_PORT=3000
API_PORT=4000
ADMIN_PORT=3001