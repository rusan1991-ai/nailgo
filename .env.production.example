# Прод-окружение NailGo. Скопируйте в .env и заполните секреты:
#   cp .env.production.example .env
#
# Значения ниже читают docker-compose.prod.yml и API (apps/api/src/env.ts).

# Домен сайта: на него Caddy выпустит сертификат Let's Encrypt.
APP_DOMAIN=nailmarket.ru

# Порт API внутри docker-сети и его адрес для Caddy.
API_PORT=4000
API_UPSTREAM=api:4000

NODE_ENV=production
TZ=Europe/Moscow

# --- База данных ---
# Пароль и пользователь попадают в том postgres_data при первом запуске.
POSTGRES_DB=nailmarket
POSTGRES_USER=nailmarket
POSTGRES_PASSWORD=change_me_postgres_password
# Адрес базы глазами контейнера API (имя сервиса из compose).
DATABASE_URL=postgresql://nailmarket:change_me_postgres_password@postgres:5432/nailmarket
# Размер пула соединений API к Postgres.
PG_POOL_MAX=10

# --- Токены входа ---
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Код подтверждения входа (OTP) ---
# response — код возвращается в ответе API (только для локальной разработки);
# log      — код пишется в лог сервера (закрытый стенд, пока нет SMS-провайдера);
# sms      — отправка через провайдера (ещё не реализована: API ответит 503).
OTP_DELIVERY=log
DEV_OTP_ENABLED=false
OTP_TTL_SECONDS=300

# Шаг сетки слотов в расписании, минуты.
SLOT_STEP_MINUTES=30

# --- На будущее (в коде ещё нет, добавьте вместе с реализацией) ---
# REDIS_URL=redis://redis:6379
# S3_ENDPOINT=https://s3.example.ru
# SMTP_HOST=smtp.example.ru
# SMS_PROVIDER_TOKEN=change_me
