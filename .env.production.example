# Production environment for Nail 2 Go.
#   cp .env.production.example .env.production
# Replace every CHANGE_ME value before the first `docker compose up`.
# Generate random secrets/passwords with: openssl rand -hex 32

# Public site hostname and API bind address (public API traffic goes through Nginx).
APP_DOMAIN=nail2go.ru
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
TZ=Europe/Moscow

# --- PostgreSQL 17 (persistent docker volume: postgres_data) ---
POSTGRES_DB=nailgo
POSTGRES_USER=nailgo
# Use a hex value so it is safe both in PostgreSQL and in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_HEX
# Keep the password above identical here; hostname `postgres` is the Compose service.
DATABASE_URL=postgresql://nailgo:CHANGE_ME_POSTGRES_HEX@postgres:5432/nailgo
PG_POOL_MAX=10

# Bootstrap the demo geo directory, demo masters and demo administrator once,
# only if all application tables are empty. Safe to leave enabled after first start.
AUTO_SEED_ON_EMPTY=true

# Nginx reads certificates from this host directory. Certbot's HTTP-01 challenge
# directory is shared with the frontend container.
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=./certbot/www

# --- Authentication and session tokens ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_HEX
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_PEPPER=CHANGE_ME_OTP_PEPPER_HEX

# Paid SMS is not configured: phone OTP is disabled in production.
DEV_OTP_ENABLED=false
OTP_DELIVERY=log
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT_PER_PHONE=5
OTP_REQUEST_LIMIT_PER_IP=30
OTP_VERIFY_LIMIT=5
OTP_WINDOW_SECONDS=900

# --- Booking rules and scheduler ---
PLATFORM_TIMEZONE=Europe/Moscow
SLOT_STEP_MINUTES=30
DEFAULT_DAY_START_MINUTE=600
DEFAULT_DAY_END_MINUTE=1200
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_CONFIRM_DEADLINE_MINUTES=120
BOOKING_AUTOCOMPLETE_HOURS=24
CANCEL_FREE_HOURS=6
LATE_CANCEL_LIMIT=3
NO_SHOW_LIMIT=2
SCHEDULER_INTERVAL_SECONDS=60

# --- Notifications and delivery ---
DELIVERY_TRANSPORT=auto
DELIVERY_WEBHOOK_URL=
DELIVERY_INTERVAL_SECONDS=30
DELIVERY_MAX_ATTEMPTS=3

# --- Website URLs and OAuth ---
# OAuth callbacks are {OAUTH_REDIRECT_BASE}/api/auth/oauth/{yandex|vk}/callback.
PUBLIC_WEB_URL=https://nail2go.ru
OAUTH_REDIRECT_BASE=https://nail2go.ru
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_AUTH_URL=https://oauth.yandex.ru
YANDEX_API_URL=https://login.yandex.ru
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_AUTH_URL=https://id.vk.com
VK_API_VERSION=5.199

# --- Telegram / Max bots (optional) ---
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_HEX
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=CHANGE_ME_MAX_HEX
MAX_APP_URL=https://max.ru
BOT_LOGIN_TTL_MINUTES=10
MAGIC_LINK_TTL_MINUTES=10080

# --- Media storage (persistent docker volume: media_data) ---
MEDIA_DIR=/data/media
MEDIA_MAX_BYTES=5242880
MEDIA_WEB_WIDTH=1200
MEDIA_THUMB_WIDTH=320

# --- Payments ---
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_URL=
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_HEX
PAYMENT_RETURN_URL=https://nail2go.ru
PAYMENT_PUBLIC_API_URL=https://nail2go.ru

# Same-origin API route; Nginx proxies /api to the backend.
VITE_API_URL=/api
# Optional public key used by the Vite production build for Yandex Maps.
VITE_YANDEX_MAPS_KEY=
