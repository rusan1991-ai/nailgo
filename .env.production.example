# Прод-окружение NailGo. Скопируйте в .env и заполните секреты:
#   cp .env.production.example .env
#
# Значения ниже читают docker-compose.prod.yml и API (apps/api/src/env.ts).

# Домен сайта: на него Caddy выпустит сертификат Let's Encrypt.
APP_DOMAIN=nailmarket.ru

# Порт API внутри docker-сети и его адрес для Caddy.
API_PORT=4000
API_UPSTREAM=api:4000

NODE_ENV=production
TZ=Europe/Moscow

# --- База данных ---
# Пароль и пользователь попадают в том postgres_data при первом запуске.
POSTGRES_DB=nailmarket
POSTGRES_USER=nailmarket
POSTGRES_PASSWORD=change_me_postgres_password
# Адрес базы глазами контейнера API (имя сервиса из compose).
DATABASE_URL=postgresql://nailmarket:change_me_postgres_password@postgres:5432/nailmarket
# Размер пула соединений API к Postgres.
PG_POOL_MAX=10

# --- Токены входа ---
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Вход и код подтверждения (OTP) ---
# Платных SMS у площадки нет: вход идёт через Яндекс ID, VK ID и мессенджеры
# (см. блок «Вход через внешние сервисы» ниже). Код по телефону остался
# инструментом стенда и в проде выключен: OTP_DELIVERY=log означает, что код
# пишется только в журнал сервера, а /auth/request-otp отвечает 503.
OTP_DELIVERY=log
DEV_OTP_ENABLED=false
OTP_TTL_SECONDS=300

# Перец для хеша кодов: без него дамп базы позволяет подобрать 4 цифры.
# Задать своим длинным случайным значением (иначе возьмётся JWT_ACCESS_SECRET).
OTP_PEPPER=change_me_otp_pepper_long_random

# Лимиты кода входа: 5 отправок на номер, 30 на IP, 5 попыток ввода
# в скользящем окне 15 минут (0 — выключить). Меняются в админке (settings otp.*).
OTP_REQUEST_LIMIT_PER_PHONE=5
OTP_REQUEST_LIMIT_PER_IP=30
OTP_VERIFY_LIMIT=5
OTP_WINDOW_SECONDS=900

# Правила времени и статусов записей (этап 1, docs/ARCHITECTURE.md)
PLATFORM_TIMEZONE=Europe/Moscow
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_CONFIRM_DEADLINE_MINUTES=120
BOOKING_AUTOCOMPLETE_HOURS=24
CANCEL_FREE_HOURS=6
LATE_CANCEL_LIMIT=3
NO_SHOW_LIMIT=2
SCHEDULER_INTERVAL_SECONDS=60

# Шаг сетки слотов в расписании, минуты.
SLOT_STEP_MINUTES=30

# --- Доставка сообщений ---
# SMS не отправляем: сообщение уходит в привязанный мессенджер, а если канала
# нет — остаётся в журнале системы (и видно в кабинете).
# Действующее значение можно поменять и в админке (/admin/deliveries).
#   auto    — канал выбирается по привязке: Telegram → Max → журнал;
#   log     — всё пишется в журнал системы (закрытый стенд);
#   webhook — POST на DELIVERY_WEBHOOK_URL: свой обработчик или внешний шлюз.
DELIVERY_TRANSPORT=auto
DELIVERY_WEBHOOK_URL=
DELIVERY_INTERVAL_SECONDS=30
DELIVERY_MAX_ATTEMPTS=3

# --- Вход через внешние сервисы (этап 2) ---
# Пустой CLIENT_ID означает «провайдер не подключён»: кнопка на экране входа
# показывается выключенной, а /auth/oauth/<провайдер>/start отвечает 503.
# Адрес возврата: должен совпадать с настройкой приложения у провайдера
# (OAUTH_REDIRECT_BASE + /api/auth/oauth/<провайдер>/callback).
PUBLIC_WEB_URL=https://nailgo.example.ru
OAUTH_REDIRECT_BASE=https://api.nailgo.example.ru
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# --- Боты мессенджеров: бесплатные уведомления и вход по диплинку ---
# Telegram: токен из @BotFather, username бота — для ссылки t.me/<bot>?start=<токен>.
# Секрет вебхука проверяется в заголовке x-telegram-bot-api-secret-token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change_me_telegram_secret
# Max: токен бота из dev.max.ru, домен обязателен — platform-api2.max.ru.
# Максимум требует TLS-цепочку Минцифры: в Node может понадобиться
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/russian_trusted_root_ca.crt
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=change_me_max_secret
# Сколько живёт одноразовая ссылка входа через бота, минуты.
BOT_LOGIN_TTL_MINUTES=10

# --- Медиа мастеров: аватар, портфолио, сертификаты ---
# Файлы лежат на диске (том media_data в docker-compose), в базе — метаданные.
MEDIA_DIR=/data/media
MEDIA_MAX_BYTES=5242880
MEDIA_WEB_WIDTH=1200
MEDIA_THUMB_WIDTH=320

# --- Предоплата за запись ---
# manual — деньги принимает мастер; webhook — платёжный шлюз (возвращает ссылку
# на оплату и сообщает об оплате вебхуком POST /api/payments/webhook).
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_URL=
# Адрес сайта (возврат клиента после оплаты) и публичный адрес API (callback для шлюза).
PAYMENT_RETURN_URL=https://nailgo.example.ru
PAYMENT_PUBLIC_API_URL=https://api.nailgo.example.ru
PAYMENT_WEBHOOK_SECRET=change_me

# --- На будущее (в коде ещё нет, добавьте вместе с реализацией) ---
# REDIS_URL=redis://redis:6379
# S3_ENDPOINT=https://s3.example.ru
# SMTP_HOST=smtp.example.ru

# --- Карта на сайте (фронтенд) ---
# Ключ JavaScript API Яндекс.Карт: https://developer.tech.yandex.ru/services
# Без ключа карта на главной работает виджетом Яндекса (без меток мастеров),
# а список мастеров показывается рядом. Vite читает переменную при сборке.
VITE_YANDEX_MAPS_KEY=
