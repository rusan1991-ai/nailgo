# Локально: PGlite — Postgres, скомпилированный в WASM, данные в каталоге .pglite
DATABASE_URL="pglite://./.pglite"
# На сервере:
# DATABASE_URL="postgresql://nailmarket:пароль@postgres:5432/nailmarket"

PORT=4000
HOST=127.0.0.1
NODE_ENV=development

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP: куда уходит код подтверждения.
#   response — возвращается в ответе API (локальная разработка);
#   log      — пишется в лог сервера (стенд, пока не подключён SMS-провайдер);
#   sms      — через провайдера (ещё не реализован: API ответит 503).
OTP_DELIVERY=response
DEV_OTP_ENABLED=true
OTP_TTL_SECONDS=300

# --- Доставка сообщений (SMS, письма, push) ---
# Транспорт по умолчанию. Его же можно переключить в админке (/admin/deliveries)
# без перезапуска сервера:
#   log     — сообщение пишется в лог и считается отправленным (стенд, локальная разработка);
#   webhook — POST-запрос на DELIVERY_WEBHOOK_URL (любой шлюз: SMS, почта, свой сервис);
#   smsru   — SMS.ru, нужен SMSRU_API_ID.
DELIVERY_TRANSPORT=log
DELIVERY_WEBHOOK_URL=
SMSRU_API_ID=
# Как часто рассыльщик проверяет очередь, секунды (0 — только вручную из админки).
DELIVERY_INTERVAL_SECONDS=30
# Сколько раз пробовать отправить сообщение, прежде чем пометить failed.
DELIVERY_MAX_ATTEMPTS=3

# --- Предоплата за запись ---
# Процент предоплаты задаёт мастер по каждой услуге; здесь — как деньги принимаем:
#   manual  — оплату принимает мастер (перевод, наличные), факт отмечается в кабинете;
#   webhook — платёжный шлюз: ему отправляем операцию, он возвращает ссылку
#             на оплату и сообщает об оплате вебхуком POST /api/payments/webhook.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_URL=
# Адрес сайта и адрес API, которые мы сообщаем шлюзу (возврат клиента и callback).
PAYMENT_RETURN_URL=http://localhost:5173
PAYMENT_PUBLIC_API_URL=http://127.0.0.1:4000
# Если задан — вебхук шлюза принимается только с заголовком x-payment-secret.
PAYMENT_WEBHOOK_SECRET=

# Сетка записи
SLOT_STEP_MINUTES=30
DEFAULT_DAY_START_MINUTE=600
DEFAULT_DAY_END_MINUTE=1200
