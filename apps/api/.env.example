# Локально: PGlite — Postgres, скомпилированный в WASM, данные в каталоге .pglite
DATABASE_URL="pglite://./.pglite"
# На сервере:
# DATABASE_URL="postgresql://nailmarket:пароль@postgres:5432/nailmarket"

PORT=4000
HOST=127.0.0.1
NODE_ENV=development

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP: куда уходит код подтверждения.
#   response — возвращается в ответе API (локальная разработка);
#   log      — пишется в лог сервера (стенд, пока не подключён SMS-провайдер);
#   sms      — через провайдера (ещё не реализован: API ответит 503).
# Вход по коду — способ стенда: в проде /auth/request-otp отвечает 503,
# вход идёт через Яндекс ID, VK ID и мессенджеры (блок ниже).
OTP_DELIVERY=response
DEV_OTP_ENABLED=true
OTP_TTL_SECONDS=300

# Лимиты кода входа (защита от SMS-спама и подбора).
# В разработке по умолчанию свободные (200/1000/200) — автотесты входят часто.
# В проде дефолты жёсткие: 5 кодов на номер, 30 на IP, 5 попыток ввода за 15 мин.
# 0 — лимит выключен. Значения можно менять в админке (settings otp.*).
OTP_REQUEST_LIMIT_PER_PHONE=
OTP_REQUEST_LIMIT_PER_IP=
OTP_VERIFY_LIMIT=
OTP_WINDOW_SECONDS=900
# Перец для хеша кодов: с ним дамп базы не даёт подобрать 4 цифры. На проде задать обязательно.
OTP_PEPPER=

# Правила времени и статусов записей (см. docs/ARCHITECTURE.md, этап 1)
PLATFORM_TIMEZONE=Europe/Moscow
# Сколько минут до визита считается занятым: записаться «в прошлое» нельзя.
BOOKING_MIN_LEAD_MINUTES=60
# Мастер не подтвердил заявку за это время — она отменяется автоматически.
BOOKING_CONFIRM_DEADLINE_MINUTES=120
# Визит прошёл, а мастер его не закрыл — через столько часов запись закроется сама.
BOOKING_AUTOCOMPLETE_HOURS=24
# Отмена позже этого числа часов до визита считается поздней.
CANCEL_FREE_HOURS=6
# Столько поздних отмен — и клиенту нужна полная предоплата.
LATE_CANCEL_LIMIT=3
# Столько неявок — и клиент попадает в чёрный список.
NO_SHOW_LIMIT=2
# Планировщик статусов, секунды (0 — выключен, прогон только вручную).
SCHEDULER_INTERVAL_SECONDS=60

# --- Доставка сообщений ---
# SMS не отправляем: сообщение уходит в привязанный мессенджер, а без привязки
# остаётся в журнале системы. Транспорт можно переключить в админке
# (/admin/deliveries) без перезапуска сервера:
#   auto    — по каналу человека: Telegram → Max → журнал системы;
#   log     — всё пишется в журнал (стенд, локальная разработка);
#   webhook — POST-запрос на DELIVERY_WEBHOOK_URL (свой обработчик или внешний шлюз).
DELIVERY_TRANSPORT=auto
DELIVERY_WEBHOOK_URL=
# Как часто рассыльщик проверяет очередь, секунды (0 — только вручную из админки).
DELIVERY_INTERVAL_SECONDS=30
# Сколько раз пробовать отправить сообщение, прежде чем пометить failed.
DELIVERY_MAX_ATTEMPTS=3

# --- Предоплата за запись ---
# Процент предоплаты задаёт мастер по каждой услуге; здесь — как деньги принимаем:
#   manual  — оплату принимает мастер (перевод, наличные), факт отмечается в кабинете;
#   webhook — платёжный шлюз: ему отправляем операцию, он возвращает ссылку
#             на оплату и сообщает об оплате вебхуком POST /api/payments/webhook.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_URL=
# Адрес сайта и адрес API, которые мы сообщаем шлюзу (возврат клиента и callback).
PAYMENT_RETURN_URL=http://localhost:5173
PAYMENT_PUBLIC_API_URL=http://127.0.0.1:4000
# Если задан — вебхук шлюза принимается только с заголовком x-payment-secret.
PAYMENT_WEBHOOK_SECRET=

# Сетка записи
SLOT_STEP_MINUTES=30
DEFAULT_DAY_START_MINUTE=600
DEFAULT_DAY_END_MINUTE=1200

# --- Вход через внешние сервисы и боты (этап 2) ---
# Пустой CLIENT_ID = провайдер не подключён: кнопка на входе выключена.
PUBLIC_WEB_URL=http://localhost:5173
OAUTH_REDIRECT_BASE=http://127.0.0.1:4000
YANDEX_AUTH_URL=https://oauth.yandex.ru
YANDEX_API_URL=https://login.yandex.ru
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_AUTH_URL=https://id.vk.com
VK_API_VERSION=5.199
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Боты: вход по диплинку t.me/<bot>?start=<токен> и бесплатные напоминания.
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=dev_telegram_secret
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=dev_max_secret
BOT_LOGIN_TTL_MINUTES=10

# --- Медиа мастеров ---
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=5242880
MEDIA_WEB_WIDTH=1200
MEDIA_THUMB_WIDTH=320
