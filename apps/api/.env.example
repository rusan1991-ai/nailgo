# Локально: PGlite — Postgres, скомпилированный в WASM, данные в каталоге .pglite
DATABASE_URL="pglite://./.pglite"
# На сервере:
# DATABASE_URL="postgresql://nailmarket:пароль@postgres:5432/nailmarket"

PORT=4000
HOST=127.0.0.1
NODE_ENV=development

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP: в dev код возвращается в ответе API, на проде уходит в SMS
DEV_OTP_ENABLED=true
OTP_TTL_SECONDS=300

# Сетка записи
SLOT_STEP_MINUTES=30
DEFAULT_DAY_START_MINUTE=600
DEFAULT_DAY_END_MINUTE=1200
