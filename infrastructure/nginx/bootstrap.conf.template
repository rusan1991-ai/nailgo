server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __APP_DOMAIN__;

    # Explicit MIME map for static assets (also present in nginx:stable-alpine's http config).
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    root /usr/share/nginx/html;
    client_max_body_size 8m;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Certbot writes HTTP-01 challenge files into the shared host webroot.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $api_upstream nailgo-backend:4000;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Vite's fingerprinted assets are immutable static files, never an SPA fallback.
    location ^~ /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
